<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:theme="@style/Theme.AppCompat">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints"
        android:padding="7dp"
        android:orientation="horizontal"
        >
        <TextView
            android:id="@+id/score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Score: 0" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp"
        tools:ignore="MissingConstraints"
        android:paddingTop="30dp"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >


            <Button
                android:id="@+id/do_bajo"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:backgroundTint="@color/do_bajo"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"
                android:text="DO"
                android:textColor="@android:color/white"/>


            <Button
                android:id="@+id/re"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="RE"
                android:backgroundTint="@color/re"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/mi"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="MI"
                android:backgroundTint="@color/mi"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/fa"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="FA"
                android:backgroundTint="@color/fa"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/sol"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="SOL"
                android:backgroundTint="@color/sol"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/la"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="LA"
                android:backgroundTint="@color/la"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/si"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="SI"
                android:backgroundTint="@color/si"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>

            <Button
                android:id="@+id/do_alto"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/button"
                android:text="DO"
                android:backgroundTint="@color/do_alto"
                android:drawableTop="@drawable/scale"
                android:paddingTop="10dp"/>
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>