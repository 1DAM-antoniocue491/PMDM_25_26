<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="?attr/colorPrimary"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/statistics"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/statistics"
            android:background="?attr/colorPrimary"
            app:tint="?attr/colorPrimaryVariant"/>

        <View
            android:layout_width="250dp"
            android:layout_height="match_parent"/>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/settings"
            android:background="?attr/colorPrimary"
            app:tint="?attr/colorPrimaryVariant" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tic_tac_toe"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textSize="40sp"
        android:textColor="?attr/colorPrimaryVariant" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="79dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="70sp"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/x_symbol"
            app:tint="@color/red" />

        <ImageView
            android:layout_width="70sp"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/circle"
            app:tint="@color/blue" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/component_rounded1"
            android:padding="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15sp"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/board_size"
                    app:tint="?attr/colorSecondaryVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/board_size"
                    android:textColor="?attr/colorSecondaryVariant"
                    android:textStyle="bold"
                    android:layout_marginStart="7sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                >

                <Button
                    android:id="@+id/game3"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="3x3"
                    android:layout_marginRight="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />

                <Button
                    android:id="@+id/game6"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="6x6"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />

                <Button
                    android:id="@+id/game9"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="9x9"
                    android:layout_marginLeft="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/component_rounded1"
            android:padding="20dp"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15sp"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/board_size"
                    app:tint="?attr/colorSecondaryVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jugador_inicial"
                    android:textColor="?attr/colorSecondaryVariant"
                    android:textStyle="bold"
                    android:layout_marginStart="7sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                >

                <Button
                    android:id="@+id/player1"
                    android:layout_width="155dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="@string/player_1"
                    android:layout_marginEnd="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />

                <Button
                    android:id="@+id/player2"
                    android:layout_width="155dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="@string/player_2"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/component_rounded1"
            android:padding="20dp"
            android:layout_gravity="center"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15sp"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/board_size"
                    app:tint="?attr/colorSecondaryVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/modo_de_juego"
                    android:textColor="?attr/colorSecondaryVariant"
                    android:textStyle="bold"
                    android:layout_marginStart="7sp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                >

                <Button
                    android:id="@+id/computer"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="Computer"
                    android:layout_marginRight="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />

                <Button
                    android:id="@+id/person"
                    android:layout_width="155dp"
                    android:layout_height="match_parent"
                    android:backgroundTint="?attr/colorOnPrimary"
                    android:text="Person"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:textColor="?attr/colorSecondaryVariant"
                    />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="180dp"
            >
            <Button
                android:id="@+id/play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Play"
                android:textColor="?attr/colorSecondaryVariant"
                android:backgroundTint="?attr/colorSecondary"
                android:drawableTop="@drawable/component_rounded1"
                android:gravity="center"
                />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>