<resources>
    <!-- Base application theme. -->
    <style name="Theme.Default" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_sky_blue</item>
        <item name="colorPrimaryVariant">@color/eclipse</item>
        <item name="colorOnPrimary">@color/eclipse_200</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_cian</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorBackgroundFloating">@color/red</item>
        <item name="colorContainer">@color/blue</item>
    </style>

    <style name="Theme.Default.CeldaJuego">
        <item name="android:padding">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetLeft">0dp</item>
    </style>
</resources>