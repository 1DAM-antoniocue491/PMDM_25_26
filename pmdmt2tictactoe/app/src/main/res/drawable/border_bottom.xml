<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo transparente (o el color que quieras para el interior) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Línea en la parte inferior: altura = grosor del borde, color desde el tema -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <!-- Ajusta aquí el grosor del borde -->
            <size android:height="2dp" />
            <solid android:color="?attr/colorPrimaryVariant" />
        </shape>
    </item>

</layer-list>
